---
/**
 * SaaSKit SDKs home — language index + left sidebar.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

// Starlight 0.42 pulls a native addon into this module. Netlify's SSR
// function omits that binding, so request-time render 500s. Bake HTML
// at build time instead (same path as content MDX pages).
export const prerender = true
import { getCollection } from 'astro:content'
import SDKCards from '@components/SDKCards.astro'
import { getSDKConfigs, type SDKConfig } from '@/utils/release-helpers'
import '@/styles/pages/sdks.css'
import '@/styles/sdk-reference.css'

const releases = await getCollection('github-releases')
const all = getSDKConfigs(releases)

const sdks: SDKConfig[] = [
  all.node,
  all.express,
  all.nextjs,
  all.python,
  all.flask,
  all.fastapi,
  all.django,
  all.go,
  all.java,
  all.expo,
  all.ios,
]

const frontmatter = {
  title: 'SaaSKit SDKs',
  description:
    'Install a language SDK or session middleware and explore clients such as Organizations and Users from the left sidebar',
  template: 'doc' as const,
  topic: 'saaskit-sdks',
  tableOfContents: false,
  prev: false,
  next: false,
}
---

<StarlightPage frontmatter={frontmatter} hasSidebar={true}>
  <div class="sdk-hub-with-sidebar">
    <p>
      Pick a language SDK or session middleware from the list below. Open the language group in the
      left sidebar to install the client or protect a route.
    </p>
    <SDKCards sdks={sdks} />
  </div>
</StarlightPage>
