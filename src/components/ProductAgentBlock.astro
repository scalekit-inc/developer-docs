---
import { Code, TabItem } from '@astrojs/starlight/components'
import Tabs from './ui/Tabs.astro'
import { setupOneLiner } from '../configs/agent-instructions'
import { PRODUCT_PROMPTS, type ProductSkill } from '../configs/product-prompts'

interface Props {
  skill: ProductSkill
  example?: string
  syncKey?: string
}

const { skill, example, syncKey = 'product-agent-cli' } = Astro.props
if (!(skill in PRODUCT_PROMPTS)) {
  throw new Error(
    `ProductAgentBlock: unknown skill "${skill}". Expected one of: ${Object.keys(PRODUCT_PROMPTS).join(', ')}`,
  )
}
const prompt = example ?? PRODUCT_PROMPTS[skill]
---

<Tabs syncKey={syncKey}>
  <TabItem label="Recommended">
    <Code
      code={setupOneLiner}
      lang="bash"
      title="Terminal"
      frame="terminal"
      showLineNumbers={false}
    />
  </TabItem>
  <TabItem label="Global install (for repeated use)">
    <Code
      code={'npm install -g @scalekit-inc/cli\nscalekit setup'}
      lang="bash"
      title="Terminal"
      frame="terminal"
      showLineNumbers={false}
    />
  </TabItem>
</Tabs>

<p>
  Paste this prompt. It names <code>{skill}</code>:
</p>
<Code code={prompt} lang="text" title="Example prompt" showLineNumbers={false} wrap />
