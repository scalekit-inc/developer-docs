---
import { PRODUCT_PROMPT_CTA, PRODUCT_PROMPTS, type ProductSkill } from '../configs/product-prompts'

interface Props {
  skill: ProductSkill
  example?: string
  /** Hide the "Using a coding agent?" lead when the surrounding heading already says it. */
  hideLead?: boolean
}

const { skill, example, hideLead = false } = Astro.props
if (!(skill in PRODUCT_PROMPTS)) {
  throw new Error(
    `ProductAgentBlock: unknown skill "${skill}". Expected one of: ${Object.keys(PRODUCT_PROMPTS).join(', ')}`,
  )
}
const prompt = example ?? PRODUCT_PROMPTS[skill]
const label = PRODUCT_PROMPT_CTA[skill]
---

<p class="product-agent-cta">
  {hideLead ? null : 'Using a coding agent?'}
  <button
    type="button"
    class="product-agent-cta__copy"
    data-product-prompt-copy
    data-idle={label}
    aria-label={label}
  >
    <svg
      class="product-agent-cta__icon"
      viewBox="0 0 16 16"
      width="14"
      height="14"
      aria-hidden="true"
    >
      <rect
        x="5.5"
        y="5.5"
        width="8"
        height="8"
        rx="1.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"></rect>
      <path
        d="M10.5 5.5V4.25A1.25 1.25 0 0 0 9.25 3H4.25A1.25 1.25 0 0 0 3 4.25v5A1.25 1.25 0 0 0 4.25 10.5H5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span data-label>{label}</span>
  </button>
  <span class="sr-only" data-live aria-live="polite"></span>
  <script type="application/json" data-product-prompt set:html={JSON.stringify(prompt)} />
</p>

<style>
  .product-agent-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  .product-agent-cta__copy {
    appearance: none;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    margin: 0;
    padding: 0.2rem 0.55rem 0.2rem 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sk-radius-md, 0.375rem);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
    transition:
      background-color var(--sk-hover-duration, 150ms) ease,
      border-color var(--sk-hover-duration, 150ms) ease,
      color var(--sk-hover-duration, 150ms) ease;
  }
  .product-agent-cta__copy::before {
    content: '';
    position: absolute;
    inset: -0.25rem;
  }
  .product-agent-cta__icon {
    flex-shrink: 0;
    color: var(--sl-color-accent);
  }
  .product-agent-cta__copy:hover {
    background-color: var(--sl-color-gray-6);
    border-color: var(--sk-hover-border, var(--sl-color-gray-4));
  }
  .product-agent-cta__copy:active {
    transform: scale(0.98);
  }
  .product-agent-cta__copy:focus-visible {
    outline: var(--sk-focus-ring, 2px solid var(--sl-color-accent));
    outline-offset: 2px;
  }
  .product-agent-cta__copy[data-state='copied'] {
    color: var(--sl-color-accent);
  }
  .product-agent-cta__copy[data-state='error'] {
    color: var(--sl-color-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .product-agent-cta__copy {
      transition: none;
    }
    .product-agent-cta__copy:active {
      transform: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const RESET_MS = 1600

  function payload(btn: HTMLButtonElement): string {
    const host = btn.closest('.product-agent-cta')
    const raw = host?.querySelector('[data-product-prompt]')?.textContent
    if (!raw) return ''
    return JSON.parse(raw) as string
  }

  function bind(btn: HTMLButtonElement) {
    if (btn.dataset.ready === 'true') return
    btn.dataset.ready = 'true'
    const label = btn.querySelector<HTMLElement>('[data-label]')
    if (!label) return
    const idle = btn.dataset.idle ?? 'Copy prompt'
    const actionName = btn.getAttribute('aria-label') ?? idle
    const live = btn.closest('.product-agent-cta')?.querySelector<HTMLElement>('[data-live]')
    let resetTimer: number | undefined

    const show = (state: 'idle' | 'copied' | 'error', text: string) => {
      btn.dataset.state = state
      label.textContent = text
      btn.setAttribute('aria-label', state === 'idle' ? actionName : text)
      if (live) live.textContent = state === 'idle' ? '' : text
    }

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(payload(btn))
        show('copied', 'Copied')
      } catch {
        show('error', 'Copy failed')
      }
      window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => show('idle', idle), RESET_MS)
    })
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-product-prompt-copy]').forEach(bind)
  }

  init()
  document.addEventListener('astro:page-load', init)
</script>
