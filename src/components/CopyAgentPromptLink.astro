---
import { homepagePrompt } from '../configs/page-actions.config'

const previewLines = homepagePrompt
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean)
  .slice(0, 2)

const actionIdle = 'Copy'
const actionName = 'Copy a Scalekit quickstart prompt for your coding agent'
---

<div class="copy-agent-prompt-wrap">
  <button
    type="button"
    class="copy-agent-prompt"
    data-idle-label={actionIdle}
    aria-label={actionName}
  >
    <span class="copy-agent-prompt__preview" aria-hidden="true">
      {previewLines.map((line) => <span class="copy-agent-prompt__line">{line}</span>)}
    </span>
    <span class="copy-agent-prompt__action" data-label>{actionIdle}</span>
  </button>
  <span class="sr-only" data-live aria-live="polite"></span>
  <script type="application/json" data-homepage-prompt set:html={JSON.stringify(homepagePrompt)} />
</div>

<style>
  .copy-agent-prompt-wrap {
    display: flex;
    width: 100%;
    max-width: 100%;
  }

  .copy-agent-prompt {
    appearance: none;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.5rem 0.75rem;
    box-sizing: border-box;
    width: 100%;
    min-height: 2.75rem;
    margin: 0;
    padding: 0.55rem 0.65rem 0.55rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--sk-radius-md, 0.375rem);
    background: var(--sl-color-bg);
    font: inherit;
    color: var(--sl-color-text);
    text-align: left;
    cursor: pointer;
  }

  .copy-agent-prompt::before {
    content: '';
    position: absolute;
    inset: -0.15rem;
  }

  .copy-agent-prompt__preview {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--sl-color-text);
  }

  .copy-agent-prompt__line {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-agent-prompt__action {
    flex-shrink: 0;
    padding-top: 0.05rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--sl-color-accent);
    white-space: nowrap;
  }

  .copy-agent-prompt:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline));
  }

  .copy-agent-prompt:hover .copy-agent-prompt__action {
    color: var(--sl-color-accent-high, var(--sl-color-accent));
  }

  .copy-agent-prompt:focus-visible {
    outline: var(--sk-focus-ring, 2px solid var(--sl-color-accent));
    outline-offset: 2px;
  }

  .copy-agent-prompt:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-agent-prompt:active {
      transform: none;
    }
  }

  .copy-agent-prompt[data-state='copied'] .copy-agent-prompt__action {
    color: var(--sk-color-agent-ink, var(--sl-color-accent));
  }

  .copy-agent-prompt[data-state='error'] .copy-agent-prompt__action {
    color: var(--sl-color-text);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const RESET_MS = 2000

  function payload(wrap: Element): string {
    const node = wrap.querySelector('[data-homepage-prompt]')
    if (!node?.textContent) return ''
    return JSON.parse(node.textContent) as string
  }

  function bind(wrap: Element) {
    const btn = wrap.querySelector<HTMLButtonElement>('.copy-agent-prompt')
    const labelEl = wrap.querySelector<HTMLElement>('[data-label]')
    const live = wrap.querySelector<HTMLElement>('[data-live]')
    if (!btn || !labelEl || btn.dataset.ready === 'true') return
    btn.dataset.ready = 'true'

    const idle = btn.dataset.idleLabel ?? 'Copy'
    const actionName =
      btn.getAttribute('aria-label') ?? 'Copy a Scalekit quickstart prompt for your coding agent'

    const show = (state: 'idle' | 'copied' | 'error', text: string) => {
      btn.dataset.state = state
      labelEl.textContent = text
      btn.setAttribute('aria-label', state === 'idle' ? actionName : text)
      if (live) live.textContent = state === 'idle' ? '' : text
    }

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(payload(wrap))
        show('copied', 'Copied')
      } catch {
        show('error', 'Copy failed')
      }
      window.setTimeout(() => show('idle', idle), RESET_MS)
    })
  }

  function init() {
    document.querySelectorAll('.copy-agent-prompt-wrap').forEach(bind)
  }

  init()
  document.addEventListener('astro:page-load', init)
</script>
