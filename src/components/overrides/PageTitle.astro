---
import StarlightPageActionsPageTitle from 'starlight-page-actions/overrides/PageTitle.astro'
import { AGENT_PLUGIN_HEADER } from '@/configs/agent-instructions'
import { coverageLabel, displayTitle, normalizeAuth, operatorOf } from '@/lib/connector-catalog'

const {
  title,
  description,
  descriptionHtml,
  connectorIcon,
  connectorAuthType,
  connectorCategories,
} = Astro.locals.starlightRoute.entry.data
const isConnectorPage = Boolean(connectorIcon)

const entryId = Astro.locals.starlightRoute.entry.id
const slug = entryId.replace(/\/$/, '').split('/').pop() ?? entryId
const pageTitle = isConnectorPage ? displayTitle(title) : title
const operator = operatorOf(slug)
let toolCount = 0
if (isConnectorPage) {
  const { default: toolsIndex } = await import('@/data/agent-connectors/tools-index.json')
  toolCount = (toolsIndex as Array<{ slug: string }>).filter((row) => row.slug === slug).length
}
const coverage = coverageLabel(toolCount)
const comingSoon = toolCount === 0
const authLabel = connectorAuthType ? normalizeAuth(connectorAuthType) : ''
---

<div class="page-title-wrapper">
  {
    isConnectorPage ? (
      <>
        <div class="connector-title-row">
          <img src={connectorIcon} width="44" height="44" alt="" class="connector-logo" />
          <div class="connector-title-content">
            <div class="connector-heading-line">
              <h1 id="_top">{pageTitle}</h1>
              <span class="connector-chip operator-chip" data-kind={operator.kind}>
                {operator.label}
              </span>
              <span class:list={['connector-chip', 'coverage-chip', { soon: comingSoon }]}>
                {coverage}
              </span>
              {authLabel && <span class="connector-chip auth-chip">{authLabel}</span>}
              {connectorCategories?.map((cat) => (
                <span class="connector-chip cat-chip">{cat}</span>
              ))}
            </div>
            {descriptionHtml ? (
              <p class="page-description" set:html={descriptionHtml} />
            ) : (
              description && <p class="page-description">{description}</p>
            )}
          </div>
        </div>
        {/* display:contents lets the action buttons become direct flex children,
            preserving the existing order:3 rule while hiding the duplicate H1 */}
        <div class="actions-only">
          <StarlightPageActionsPageTitle />
        </div>
      </>
    ) : (
      <>
        <StarlightPageActionsPageTitle />
        {descriptionHtml ? (
          <p class="page-description" set:html={descriptionHtml} />
        ) : (
          description && <p class="page-description">{description}</p>
        )}
      </>
    )
  }
</div>

<style>
  .page-title-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* ── Non-connector pages: reorder via flex order ── */
  .page-title-wrapper :global(h1) {
    order: 1;
  }

  .page-description {
    order: 2;
    margin-top: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }

  .page-description :global(a) {
    color: inherit !important;
    text-decoration: underline;
  }

  .page-title-wrapper :global(.actions-container) {
    order: 3;
    margin-top: 0.75rem;
    align-self: flex-end;
  }

  /* ── Connector page title layout ── */

  /* The connector-title-row is order:0 (default), appears before the action buttons (order:3) */
  .connector-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    order: 0;
  }

  .connector-logo {
    border-radius: 8px;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-bg);
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .connector-title-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .connector-heading-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Reset order on the H1 inside our custom row — it's already in the right place */
  .connector-heading-line :global(h1) {
    order: unset;
    margin: 0;
    line-height: 1.15;
  }

  /* Description sits inside connector-title-content, not as a flex child of page-title-wrapper */
  .connector-title-content .page-description {
    order: unset;
    margin-top: 0;
  }

  /* display:contents removes the wrapper box so action buttons participate
     directly in page-title-wrapper's flex layout, picking up order:3 */
  .actions-only {
    display: contents;
  }

  /* Hide the duplicate H1 that StarlightPageActionsPageTitle renders */
  .actions-only :global(h1) {
    display: none;
  }

  /* ── Chips ── */
  .connector-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.375rem;
    border-radius: var(--sk-radius-sm, 0.25rem);
    font-family: var(--sl-font-system-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    font-synthesis: none;
    letter-spacing: 0;
    white-space: nowrap;
    line-height: 1.3;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-hairline);
  }

  .coverage-chip.soon {
    font-style: italic;
  }

  .auth-chip {
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-hairline);
  }

  .cat-chip {
    background: color-mix(in srgb, var(--sl-color-gray-4) 12%, transparent);
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
  }

  /* ── Action buttons — match sk-secondary aesthetic ── */
  .page-title-wrapper :global(.actions-container .action-button) {
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    padding: 0.5rem 1rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .page-title-wrapper :global(.actions-container .action-button:hover),
  .page-title-wrapper :global(.actions-container .action-button:focus-visible) {
    background-color: var(--sl-color-gray-6);
  }

  .page-title-wrapper :global(.actions-container .dropdown #dropdown-menu) {
    background-color: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    box-shadow:
      0 1px 2px 0 rgba(10, 10, 10, 0.05),
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .page-title-wrapper :global(.actions-container .dropdown-item) {
    color: var(--sl-color-text);
    transition: background-color 0.15s ease;
  }

  .page-title-wrapper :global(.actions-container .dropdown-item:hover) {
    background-color: var(--sl-color-gray-6);
  }
</style>

<script define:vars={{ agentPluginHeader: AGENT_PLUGIN_HEADER }}>
  // starlight-page-actions (Button.astro / Dropdown.astro, in node_modules)
  // binds "Copy Markdown" and both dropdowns at module scope with no
  // `astro:page-load` hook. Astro's ClientRouter swaps in a fresh <body> on
  // every soft navigation but never reruns an inline script whose textContent
  // already ran (see swap-functions.js `scriptsAlreadyRan`), so the package's
  // own listeners go dead after the first navigation. We can't patch
  // node_modules, so this override takes ownership of all three controls:
  // clone each control to strip the package's listeners (a clone carries no
  // event listeners), then bind our own — no capture-phase interception
  // needed once we own the element outright. Reruns on `astro:page-load`
  // (fires on first load AND after every soft nav), guarded per-render on
  // the fresh `.actions-container` so it never double-binds.
  function initPageActions() {
    const container = document.querySelector('.actions-container')
    if (!container || container.dataset.pageActionsReady === 'true') return
    container.dataset.pageActionsReady = 'true'

    const copyBtn = container.querySelector('#copy-markdown')
    if (copyBtn) {
      const clone = copyBtn.cloneNode(true)
      copyBtn.replaceWith(clone)
      clone.addEventListener('click', async () => {
        clone.disabled = true
        let cls = 'copied'
        try {
          const agentRes = await fetch(`${clone.dataset.path}.agent.md`)
          const res = agentRes.ok ? agentRes : await fetch(`${clone.dataset.path}.md`)
          if (!res.ok) throw new Error(`Failed to fetch markdown: ${res.status}`)
          const md = await res.text()
          await navigator.clipboard.writeText(agentPluginHeader + md)
        } catch {
          cls = 'error'
        } finally {
          clone.disabled = false
          clone.classList.add(cls)
          setTimeout(() => clone.classList.remove(cls), 3000)
        }
      })
    }

    for (const dropdownId of ['dropdown-0', 'dropdown-1']) {
      const dropdown = container.querySelector(`#${dropdownId}`)
      const toggle = dropdown?.querySelector('#dropdown-toggle')
      const menu = dropdown?.querySelector('#dropdown-menu')
      if (!toggle || !menu) continue

      const toggleClone = toggle.cloneNode(true)
      toggle.replaceWith(toggleClone)
      toggleClone.addEventListener('click', (e) => {
        e.stopPropagation()
        container.querySelectorAll('#dropdown-menu.show').forEach((m) => m.classList.remove('show'))
        menu.classList.toggle('show')
      })

      menu.addEventListener('click', (e) => e.stopPropagation())
    }
  }

  // `document` survives soft navigations, so the outside-click close is
  // registered once at module scope instead of inside initPageActions
  // (which would otherwise stack a duplicate listener per navigation).
  document.addEventListener('click', () => {
    document.querySelectorAll('.actions-container #dropdown-menu.show').forEach((m) => {
      m.classList.remove('show')
    })
  })

  // define:vars forces this script to render as a plain synchronous inline
  // script, which executes immediately while parsing — before the package's
  // own <script type="module"> control scripts, which are deferred until
  // after parsing. Calling initPageActions() immediately would clone the
  // buttons before the package binds anything to strip, so the package's
  // listener ends up bound to our clone too (double-fires copy/dropdown on
  // first load). Wait for DOMContentLoaded on first load so the package's
  // deferred scripts run first — mirrors SecondaryNav.astro.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageActions, { once: true })
  } else {
    initPageActions()
  }
  document.addEventListener('astro:page-load', initPageActions)
</script>
