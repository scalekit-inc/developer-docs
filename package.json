{
  "name": "scalekit-docs",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "netlify dev:exec pnpm run start",
    "start": "NETLIFY_DEV=1 astro dev",
    "test:catalog": "node --experimental-strip-types --test src/lib/connector-catalog.test.ts",
    "build": "node scripts/generate-agent-tools-index.js && pnpm run bundle:apis && node scripts/validate-api-split.js && pnpm format:check && astro build && node --experimental-strip-types scripts/generate-llms-index.js",
    "validate-api-split": "node scripts/validate-api-split.js",
    "agent-markdown:audit": "node scripts/agent-markdown-audit.js",
    "agent-markdown:audit:strict": "node scripts/agent-markdown-audit.js --strict",
    "preview": "astro preview",
    "astro": "astro",
    "upgrade": "pnpm dlx @astrojs/upgrade",
    "install:d2": "bash scripts/install-d2.sh",
    "postinstall": "node scripts/setup-git-hooks.js",
    "format:check": "prettier --check '**/*.{md,mdx,js,ts,astro,css}'",
    "format": "prettier --write '**/*.{md,mdx,js,ts,astro,css}'",
    "reorder-swagger": "node scripts/reorder-swagger.js public/api/scalekit.scalar.json",
    "bundle:apis": "redocly bundle agentkit saaskit all --remove-unused-components && redocly bundle agentkit --remove-unused-components --ext json && redocly bundle saaskit --remove-unused-components --ext json && redocly bundle all --remove-unused-components --ext json",
    "sync-agent-connectors": "node scripts/sync-agent-connectors.js"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/netlify": "^8.1.2",
    "@astrojs/starlight": "^0.41.0",
    "@astrojs/starlight-docsearch": "file:vendor/docsearch",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@expressive-code/plugin-collapsible-sections": "^0.43.1",
    "@expressive-code/plugin-line-numbers": "^0.43.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@gesslar/starlight-class-browser": "^1.0.1",
    "@iconify/json": "^2.2.465",
    "@infrasity/agent-tracker": "^0.1.1",
    "@scalar/astro": "^0.4.5",
    "@tailwindcss/vite": "^4.2.4",
    "@usesapient/agent-tracker": "^0.1.1",
    "astro": "^7.1.3",
    "astro-d2": "^0.11.0",
    "astro-loader-github-releases": "^2.1.1",
    "astro-og-canvas": "^0.10.1",
    "canvaskit-wasm": "0.40.0",
    "jose": "^6.2.2",
    "sharp": "^0.35.3",
    "starlight-blog": "^0.26.1",
    "starlight-image-zoom": "^0.14.2",
    "starlight-links-validator": "^0.24.1",
    "starlight-llms-txt": "^0.10.0",
    "starlight-page-actions": "^0.6.1",
    "starlight-sidebar-topics": "^0.8.0",
    "starlight-theme-nova": "^0.11.11",
    "starlight-videos": "^0.4.0",
    "tailwindcss": "^4.2.4",
    "unplugin-icons": "^23.0.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@redocly/cli": "^2.41.0",
    "@scalar/openapi-to-markdown": "^0.5.6",
    "netlify-cli": "^27.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pretty-quick": "^4.2.2",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@parcel/watcher",
      "netlify-cli",
      "simple-git-hooks"
    ],
    "overrides": {
      "@astrojs/starlight-docsearch": "file:./vendor/docsearch",
      "glob": "^11.0.0",
      "mdast-util-to-hast": "^13.2.1",
      "@opentelemetry/core": "^2.8.0"
    }
  }
}
